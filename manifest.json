{
  "manifest_version": 3,
  "name": "Kwitch",
  "version": "1.0.0",
  "description": "Your live followed Twitch and Kick channels in one sidebar on both sites, sorted by viewers, without multistream duplicates.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://kick.com/*",
    "https://*.kick.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://kick.com/*", "https://www.kick.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kwitch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kwitch@alexanderfeyaerts",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
